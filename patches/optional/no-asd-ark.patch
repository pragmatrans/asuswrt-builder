@@ -0,0 +1,15 @@
+/*
+ * Заглушка для збірок без GTBooster Ark (RTCONFIG_GTBOOSTER=n).
+ *
+ * Навіщо: prebuilt-об'єкт amas_lib.o (закритий, лінкується завжди) кличе
+ * IS_ARK_IAM(), а єдине визначення цього символу — у prebuilt ark.o, який
+ * збирається лише за RTCONFIG_GTBOOSTER=y. Без заглушки rc не лінкується:
+ *   amas_lib.o: undefined reference to `IS_ARK_IAM'
+ *
+ * Повертаємо 0 = «Ark IAM не підтримується», що й треба: движка немає.
+ * Файл додається до OBJS лише коли GTBOOSTER вимкнений (rc/Makefile).
+ */
+int IS_ARK_IAM(void)
+{
+	return 0;
+}
